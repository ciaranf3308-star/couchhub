<Window x:Class="CouchHub.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RedSilk Settings"
        Width="980" Height="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFont}">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="32,24">
    <StackPanel>
      <TextBlock Text="Settings" FontSize="36" FontFamily="{StaticResource DisplayFont}" Margin="0,0,0,4" />
      <Border Height="1" Background="{StaticResource HairlineBrush}" Margin="0,0,0,14" />
      <TextBlock Text="Arrows move, Enter selects, Esc closes. Gamepad works too: D-pad to move, A to select, B to close."
                 FontSize="17" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,20" TextWrapping="Wrap" />

      <TextBlock Text="Gaming  (ES-DE)" FontSize="22" FontFamily="{StaticResource DisplayFont}" />
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBox x:Name="GamingPathBox" Grid.Column="0" Style="{StaticResource SettingsTextBoxStyle}" />
        <Button Grid.Column="1" Content="Browse…" Style="{StaticResource SettingsButtonStyle}" Click="BrowseGaming_Click" />
      </Grid>
      <TextBlock Text="Launch arguments (optional — never put passwords here)" FontSize="16" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0" />
      <TextBox x:Name="GamingArgsBox" Style="{StaticResource SettingsTextBoxStyle}" />

      <TextBlock Text="TV  (HotPlayer)" FontSize="22" FontFamily="{StaticResource DisplayFont}" Margin="0,18,0,0" />
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBox x:Name="TvPathBox" Grid.Column="0" Style="{StaticResource SettingsTextBoxStyle}" />
        <Button Grid.Column="1" Content="Browse…" Style="{StaticResource SettingsButtonStyle}" Click="BrowseTv_Click" />
      </Grid>
      <TextBlock Text="HotPlayer is a Microsoft Store app, so there is no .exe to browse to. Paste its Store target here, e.g. shell:AppsFolder\&#60;PackageFamilyName&#62;!App (see the Codex handoff for how to find it), or Browse to a .lnk shortcut to HotPlayer. Arguments do not apply to a Store app." FontSize="16" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />
      <TextBlock Text="Launch arguments (optional — never put passwords here)" FontSize="16" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0" />
      <TextBox x:Name="TvArgsBox" Style="{StaticResource SettingsTextBoxStyle}" />

      <TextBlock Text="Live TV guide" FontSize="22" FontFamily="{StaticResource DisplayFont}" Margin="0,18,0,0" />
      <TextBlock Text="Free guide from open-epg — no account needed. RedSilk downloads the Ireland or UK guide and shows now / next for the channel you pick on the TV tile."
                 FontSize="16" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
      <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
        <TextBlock Text="Guide" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0" />
        <ComboBox x:Name="EpgFeedCombo" FontSize="18" Width="340" SelectionChanged="EpgFeedCombo_SelectionChanged" DropDownOpened="EpgFeedCombo_DropDownOpened">
          <ComboBoxItem Content="Ireland" Tag="https://www.open-epg.com/files/ireland.xml.gz" />
          <ComboBoxItem Content="United Kingdom" Tag="https://www.open-epg.com/files/unitedkingdom.xml.gz" />
        </ComboBox>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
        <TextBlock Text="Channel" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0" />
        <ComboBox x:Name="EpgChannelCombo" FontSize="18" Width="340" SelectionChanged="EpgChannelCombo_SelectionChanged" DropDownOpened="EpgChannelCombo_DropDownOpened" />
        <Button Content="Refresh channels" Style="{StaticResource SettingsButtonStyle}" Click="EpgRefreshChannels_Click" Margin="12,0,0,0" />
      </StackPanel>
      <TextBlock Text="Picking a channel from the other guide switches the guide above to match."
                 FontSize="16" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />

      <TextBlock Text="Provider guide (optional)" FontSize="18" Margin="0,14,0,0" />
      <TextBlock Text="Use your own IPTV provider's guide instead of the free one (Xtream Codes). Credentials stay on this PC and are only ever sent to your provider. Leave blank to use the free guide."
                 FontSize="16" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
      <TextBlock Text="Provider server URL" FontSize="16" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0" />
      <TextBox x:Name="EpgXtreamServerBox" Style="{StaticResource SettingsTextBoxStyle}" />
      <TextBlock Text="Provider username" FontSize="16" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0" />
      <TextBox x:Name="EpgXtreamUserBox" Style="{StaticResource SettingsTextBoxStyle}" />
      <TextBlock Text="Provider password" FontSize="16" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0" />
      <PasswordBox x:Name="EpgXtreamPasswordBox" Style="{StaticResource SettingsPasswordBoxStyle}" />
      <TextBlock Text="Provider channel name" FontSize="16" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0" />
      <TextBox x:Name="EpgXtreamChannelBox" Style="{StaticResource SettingsTextBoxStyle}" />

      <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
        <Button x:Name="TestGuideButton" Content="Test guide" Style="{StaticResource SettingsButtonStyle}" Click="TestGuide_Click" />
      </StackPanel>
      <TextBlock x:Name="EpgTestStatusText" Text="" FontSize="17"
                 Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />

      <TextBlock Text="YouTube  (FreeTube)" FontSize="22" FontFamily="{StaticResource DisplayFont}" Margin="0,18,0,0" />
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBox x:Name="YouTubePathBox" Grid.Column="0" Style="{StaticResource SettingsTextBoxStyle}" />
        <Button Grid.Column="1" Content="Browse…" Style="{StaticResource SettingsButtonStyle}" Click="BrowseYouTube_Click" />
      </Grid>
      <TextBlock Text="Launch arguments (optional — never put passwords here)" FontSize="16" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0" />
      <TextBox x:Name="YouTubeArgsBox" Style="{StaticResource SettingsTextBoxStyle}" />

      <TextBlock Text="Dashboard" FontSize="22" FontFamily="{StaticResource DisplayFont}" Margin="0,22,0,6" />
      <CheckBox x:Name="FullscreenCheck" Content="Fullscreen dashboard" FontSize="18" Margin="0,4" />
      <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
        <TextBlock Text="Display scaling" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0" />
        <ComboBox x:Name="ScalingCombo" FontSize="18" Width="220">
          <ComboBoxItem Content="System" Tag="System" />
          <ComboBoxItem Content="125%" Tag="125" />
          <ComboBoxItem Content="150%" Tag="150" />
          <ComboBoxItem Content="200%" Tag="200" />
        </ComboBox>
      </StackPanel>
      <CheckBox x:Name="StartupCheck" Content="Start RedSilk when Windows signs in" FontSize="18" Margin="0,10,0,0" />
      <TextBlock Text="Return-home shortcut" FontSize="18" Margin="0,12,0,0" />
      <TextBox x:Name="HotkeyBox" Style="{StaticResource SettingsTextBoxStyle}" />
      <TextBlock Text="Example: Ctrl+Alt+Home. If another app already uses it, RedSilk will say so on the dashboard."
                 FontSize="16" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />

      <TextBlock Text="Controller" FontSize="22" FontFamily="{StaticResource DisplayFont}" Margin="0,22,0,6" />
      <TextBlock x:Name="ControllerStatusText" Text="Checking…" FontSize="18"
                 Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />

      <TextBlock Text="Updates" FontSize="22" FontFamily="{StaticResource DisplayFont}" Margin="0,22,0,6" />
      <TextBlock Text="RedSilk checks for updates when it starts and stages them silently — a downloaded update applies the next time RedSilk launches, so nothing restarts mid-session. Only the copy installed via Setup.exe updates itself; a portable copy does not."
                 FontSize="16" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
        <Button x:Name="CheckUpdatesButton" Content="Check for updates" Style="{StaticResource SettingsButtonStyle}" Click="CheckUpdates_Click" />
      </StackPanel>
      <TextBlock x:Name="UpdateStatusText" Text="" FontSize="17"
                 Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,28,0,0">
        <Button Content="Exit RedSilk" Style="{StaticResource SettingsButtonStyle}" Click="Exit_Click" />
        <Button Content="Cancel" Style="{StaticResource SettingsButtonStyle}" Click="Cancel_Click" />
        <Button Content="Save" Style="{StaticResource PrimaryButtonStyle}" Click="Save_Click" />
      </StackPanel>
      <TextBlock x:Name="ErrorText" Text="" FontSize="17" Foreground="{StaticResource DangerBrush}"
                 TextWrapping="Wrap" Margin="0,12,0,0" />
    </StackPanel>
  </ScrollViewer>
</Window>
