<Window x:Class="CouchHub.NotificationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New episodes"
        Width="920" Height="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource SurfaceBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFont}"
        ShowInTaskbar="False">
  <Grid Margin="36,28,36,28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="New episodes" FontSize="38"
               FontFamily="{StaticResource DisplayFont}"
               Foreground="{StaticResource TextPrimaryBrush}" />
    <TextBlock Grid.Row="1" x:Name="SubtitleText"
               Text="From RedSilk TV — pick one to open it at that episode."
               FontSize="17" Foreground="{StaticResource TextSecondaryBrush}"
               Margin="0,6,0,0" />

    <ScrollViewer Grid.Row="2" Margin="0,22,0,0" VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="ItemsPanel" />
    </ScrollViewer>

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
      <Button x:Name="CloseButton" Content="Close" Style="{StaticResource SettingsButtonStyle}"
              Click="CloseButton_Click" />
    </StackPanel>
  </Grid>
</Window>
