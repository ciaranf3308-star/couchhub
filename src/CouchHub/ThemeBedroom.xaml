<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Bedroom dark (v0.3): deep wine burgundy, beige bright.
       Same layout, type and focus language as the Hotel theme —
       only the palette changes. No cold blue-black, no chunky borders.
       Hairlines, serif display type, soft wine focus glow.
       Every colour / size used by the dashboard and settings lives here,
       so a future theme is a new ResourceDictionary.
       CONTRACT: Theme.xaml (Hotel) and ThemeBedroom.xaml (Bedroom) must
       define exactly the same keys — the app swaps the whole dictionary
       at startup based on config, and every brush reference in the
       windows resolves against whichever one is loaded. -->
  <Color x:Key="BackgroundColor">#1E0F13</Color>
  <Color x:Key="BackgroundDeepColor">#14090C</Color>
  <Color x:Key="SurfaceColor">#2C151B</Color>
  <Color x:Key="SurfaceElevatedColor">#3B1D25</Color>
  <Color x:Key="BorderColor">#4E2833</Color>
  <Color x:Key="HairlineColor">#63343F</Color>
  <Color x:Key="BrassColor">#C14B5F</Color>
  <Color x:Key="BrassSoftColor">#D08A96</Color>
  <Color x:Key="AccentColor">#C14B5F</Color>
  <Color x:Key="AccentWarmColor">#D08A6B</Color>
  <Color x:Key="TextPrimaryColor">#F6EEE3</Color>
  <Color x:Key="TextSecondaryColor">#CDB9AC</Color>
  <Color x:Key="TextMutedColor">#9C8577</Color>
  <Color x:Key="DangerColor">#E0705F</Color>
  <Color x:Key="SuccessColor">#7FBF7A</Color>

  <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{StaticResource SurfaceElevatedColor}" />
  <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
  <SolidColorBrush x:Key="HairlineBrush" Color="{StaticResource HairlineColor}" />
  <SolidColorBrush x:Key="BrassBrush" Color="{StaticResource BrassColor}" />
  <SolidColorBrush x:Key="BrassSoftBrush" Color="{StaticResource BrassSoftColor}" />
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="AccentWarmBrush" Color="{StaticResource AccentWarmColor}" />
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
  <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
  <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />

  <!-- Hero tiles (v0.5): scrim and chrome that sit on top of the tile
       photography. The scrim is strongest at the bottom where the text
       sits and fades to nearly clear at the top, so the art stays the
       hero. Chip / track brushes are translucent so the photo shows
       through. Brand colours (YouTube red, Edge/Word/Excel/PowerPoint)
       are brand identity, not theme surfaces — they are the same in
       both themes, but they live here so MainWindow.xaml has no
       hardcoded colours at all. -->
  <LinearGradientBrush x:Key="TileScrimBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#2614090C" Offset="0" />
    <GradientStop Color="#661E0F13" Offset="0.45" />
    <GradientStop Color="#E614090C" Offset="1" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="TileChipBrush" Color="#802C151B" />
  <SolidColorBrush x:Key="TileChipBorderBrush" Color="#59F6EEE3" />
  <SolidColorBrush x:Key="TileTrackBrush" Color="#59F6EEE3" />
  <SolidColorBrush x:Key="LiveBadgeBrush" Color="#D33A2C" />
  <SolidColorBrush x:Key="YouTubeRedBrush" Color="#C1272D" />
  <SolidColorBrush x:Key="EdgeBrush" Color="#0F6CBD" />
  <SolidColorBrush x:Key="WordBrush" Color="#2B579A" />
  <SolidColorBrush x:Key="ExcelBrush" Color="#217346" />
  <SolidColorBrush x:Key="PowerPointBrush" Color="#D24726" />

  <!-- Warm vertical wash behind the dashboard: deep charcoal at the
       bottom rising to a faintly lit warm charcoal at the top. -->
  <LinearGradientBrush x:Key="BackgroundGradientBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#26131A" Offset="0" />
    <GradientStop Color="#1E0F13" Offset="0.45" />
    <GradientStop Color="#14090C" Offset="1" />
  </LinearGradientBrush>

  <FontFamily x:Key="UiFont">Segoe UI, sans-serif</FontFamily>
  <!-- Serif display face for the wordmark, tile titles and headings.
       Georgia ships with Windows, so there is nothing to install. -->
  <FontFamily x:Key="DisplayFont">Georgia, serif</FontFamily>

  <!-- Dashboard tile (v0.5): full-bleed photographic art — each tile
       sets its own art ImageBrush as Background (see App.xaml). The
       template never paints over the art: hover / focus only change the
       border, the glow and the lift, so the photo stays visible. Focus
       is unmistakable at 3 m: the hairline turns to a 2 px accent edge
       with a soft warm glow and a small lift. -->
  <Style x:Key="TileButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="Margin" Value="14" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Focusable" Value="True" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
    <Setter Property="RenderTransform">
      <Setter.Value>
        <ScaleTransform ScaleX="1" ScaleY="1" />
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Root"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="14">
            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource BrassSoftBrush}" />
            </Trigger>
            <Trigger Property="IsFocused" Value="True">
              <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource BrassBrush}" />
              <Setter TargetName="Root" Property="BorderThickness" Value="2" />
              <Setter TargetName="Root" Property="Effect">
                <Setter.Value>
                  <DropShadowEffect Color="#C14B5F" BlurRadius="32" ShadowDepth="0" Opacity="0.45" />
                </Setter.Value>
              </Setter>
              <Setter Property="RenderTransform">
                <Setter.Value>
                  <ScaleTransform ScaleX="1.03" ScaleY="1.03" />
                </Setter.Value>
              </Setter>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Small header / settings buttons. -->
  <Style x:Key="ChromeButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="20" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Padding" Value="14,6" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="10" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
              <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
            </Trigger>
            <Trigger Property="IsFocused" Value="True">
              <Setter Property="BorderBrush" Value="{StaticResource BrassBrush}" />
              <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Settings dialog controls. -->
  <Style x:Key="SettingsTextBoxStyle" TargetType="TextBox">
    <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="Margin" Value="0,4,0,4" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="8" Padding="{TemplateBinding Padding}">
            <ScrollViewer x:Name="PART_ContentHost" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsFocused" Value="True">
              <Setter Property="BorderBrush" Value="{StaticResource BrassBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Slim progress bar for the TV tile's now/next progress.
       The control sizes PART_Indicator itself from Value / Maximum,
       so the template only draws the track and the fill. -->
  <Style x:Key="SlimProgressBarStyle" TargetType="ProgressBar">
    <Setter Property="Height" Value="6" />
    <Setter Property="Minimum" Value="0" />
    <Setter Property="Maximum" Value="100" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Border x:Name="PART_Track" CornerRadius="3" Background="{StaticResource TileTrackBrush}">
            <Border x:Name="PART_Indicator" CornerRadius="3" Background="{StaticResource AccentBrush}" HorizontalAlignment="Left" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Password box for the optional Xtream guide credentials in
       Settings — same look as SettingsTextBoxStyle, but the text is
       masked. The password is never logged anywhere. -->
  <Style x:Key="SettingsPasswordBoxStyle" TargetType="PasswordBox">
    <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="Margin" Value="0,4,0,4" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="PasswordBox">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="8" Padding="{TemplateBinding Padding}">
            <ScrollViewer x:Name="PART_ContentHost" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsFocused" Value="True">
              <Setter Property="BorderBrush" Value="{StaticResource BrassBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SettingsButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="Padding" Value="16,10" />
    <Setter Property="Margin" Value="6,0" />
    <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="10" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsFocused" Value="True">
              <Setter Property="BorderBrush" Value="{StaticResource BrassBrush}" />
              <Setter Property="BorderThickness" Value="2" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}" />
              <Setter Property="BorderBrush" Value="{StaticResource BrassSoftBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource SettingsButtonStyle}">
    <Setter Property="Background" Value="{StaticResource BrassBrush}" />
    <Setter Property="Foreground" Value="#1A140F" />
    <Setter Property="BorderBrush" Value="{StaticResource BrassBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

</ResourceDictionary>
