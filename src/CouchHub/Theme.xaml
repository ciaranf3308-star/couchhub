<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Boutique-hotel dark (v0.2): warm charcoal, brass, ivory, taupe.
       No cold blue-black, no tech-dashboard blue, no chunky borders.
       Hairlines, serif display type, soft brass focus glow.
       Every colour / size used by the dashboard and settings lives here,
       so a future theme is a new ResourceDictionary. -->
  <Color x:Key="BackgroundColor">#171310</Color>
  <Color x:Key="BackgroundDeepColor">#100D0A</Color>
  <Color x:Key="SurfaceColor">#221B15</Color>
  <Color x:Key="SurfaceElevatedColor">#2C2318</Color>
  <Color x:Key="BorderColor">#3D2F1F</Color>
  <Color x:Key="HairlineColor">#4A3A26</Color>
  <Color x:Key="BrassColor">#C9A227</Color>
  <Color x:Key="BrassSoftColor">#D8B45A</Color>
  <Color x:Key="AccentColor">#C9A227</Color>
  <Color x:Key="AccentWarmColor">#D97B29</Color>
  <Color x:Key="TextPrimaryColor">#F5EFE6</Color>
  <Color x:Key="TextSecondaryColor">#B8A99A</Color>
  <Color x:Key="TextMutedColor">#8A7A68</Color>
  <Color x:Key="DangerColor">#E0705F</Color>
  <Color x:Key="SuccessColor">#7FBF7A</Color>

  <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{StaticResource SurfaceElevatedColor}" />
  <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
  <SolidColorBrush x:Key="HairlineBrush" Color="{StaticResource HairlineColor}" />
  <SolidColorBrush x:Key="BrassBrush" Color="{StaticResource BrassColor}" />
  <SolidColorBrush x:Key="BrassSoftBrush" Color="{StaticResource BrassSoftColor}" />
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="AccentWarmBrush" Color="{StaticResource AccentWarmColor}" />
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
  <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
  <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />

  <!-- Warm vertical wash behind the dashboard: deep charcoal at the
       bottom rising to a faintly lit warm charcoal at the top. -->
  <LinearGradientBrush x:Key="BackgroundGradientBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#1D1712" Offset="0" />
    <GradientStop Color="#171310" Offset="0.45" />
    <GradientStop Color="#100D0A" Offset="1" />
  </LinearGradientBrush>

  <FontFamily x:Key="UiFont">Segoe UI, sans-serif</FontFamily>
  <!-- Serif display face for the wordmark, tile titles and headings.
       Georgia ships with Windows, so there is nothing to install. -->
  <FontFamily x:Key="DisplayFont">Georgia, serif</FontFamily>

  <!-- Dashboard tile: warm surface, hairline border, generous radius.
       Focus is unmistakable at 3 m: brass hairline turns to a 2 px brass
       edge with a soft warm glow and a small lift. -->
  <Style x:Key="TileButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="Margin" Value="14" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Focusable" Value="True" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
    <Setter Property="RenderTransform">
      <Setter.Value>
        <ScaleTransform ScaleX="1" ScaleY="1" />
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Root"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="14">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceElevatedBrush}" />
              <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
            </Trigger>
            <Trigger Property="IsFocused" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceElevatedBrush}" />
              <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource BrassBrush}" />
              <Setter TargetName="Root" Property="BorderThickness" Value="2" />
              <Setter TargetName="Root" Property="Effect">
                <Setter.Value>
                  <DropShadowEffect Color="#C9A227" BlurRadius="32" ShadowDepth="0" Opacity="0.38" />
                </Setter.Value>
              </Setter>
              <Setter Property="RenderTransform">
                <Setter.Value>
                  <ScaleTransform ScaleX="1.03" ScaleY="1.03" />
                </Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceElevatedBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Small header / settings buttons. -->
  <Style x:Key="ChromeButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="20" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Padding" Value="14,6" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="10" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
              <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
            </Trigger>
            <Trigger Property="IsFocused" Value="True">
              <Setter Property="BorderBrush" Value="{StaticResource BrassBrush}" />
              <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Settings dialog controls. -->
  <Style x:Key="SettingsTextBoxStyle" TargetType="TextBox">
    <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="Margin" Value="0,4,0,4" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="8" Padding="{TemplateBinding Padding}">
            <ScrollViewer x:Name="PART_ContentHost" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsFocused" Value="True">
              <Setter Property="BorderBrush" Value="{StaticResource BrassBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SettingsButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="Padding" Value="16,10" />
    <Setter Property="Margin" Value="6,0" />
    <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="10" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsFocused" Value="True">
              <Setter Property="BorderBrush" Value="{StaticResource BrassBrush}" />
              <Setter Property="BorderThickness" Value="2" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}" />
              <Setter Property="BorderBrush" Value="{StaticResource BrassSoftBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource SettingsButtonStyle}">
    <Setter Property="Background" Value="{StaticResource BrassBrush}" />
    <Setter Property="Foreground" Value="#1A140F" />
    <Setter Property="BorderBrush" Value="{StaticResource BrassBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

</ResourceDictionary>
