<Window x:Class="CouchHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CouchHub"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFont}"
        ShowInTaskbar="True">
  <Grid x:Name="RootGrid" Margin="48,28,48,28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header: brand, clock/date, settings. -->
    <Grid Grid.Row="0" Margin="14,0,14,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="COUCHHUB" FontSize="40" FontWeight="Bold"
                 Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
      <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Right"
                  VerticalAlignment="Center" Margin="0,0,24,0">
        <TextBlock x:Name="ClockText" Text="--:--" FontSize="36" FontWeight="SemiBold"
                   HorizontalAlignment="Right" Foreground="{StaticResource TextPrimaryBrush}" />
        <TextBlock x:Name="DateText" Text="" FontSize="18"
                   HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}" />
      </StackPanel>
      <Button Grid.Column="2" x:Name="SettingsButton" Content="⚙ Settings"
              Style="{StaticResource ChromeButtonStyle}" Click="SettingsButton_Click" />
    </Grid>

    <!-- Four tiles, one row. Viewbox icons are vector shapes, no images. -->
    <UniformGrid Grid.Row="1" Columns="4" Rows="1">
      <Button x:Name="GamingTile" Tag="0" Style="{StaticResource TileButtonStyle}"
              Click="Tile_Click" GotFocus="Tile_GotFocus">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <Viewbox Width="150" Height="100">
            <Grid Width="150" Height="100">
              <Border Width="140" Height="72" CornerRadius="34" Background="#1E2534"
                      BorderBrush="#00A6FF" BorderThickness="3" HorizontalAlignment="Center" VerticalAlignment="Center" />
              <Rectangle Width="18" Height="6" Fill="#F2F5F9" HorizontalAlignment="Left" Margin="28,0,0,0" VerticalAlignment="Center" />
              <Rectangle Width="6" Height="18" Fill="#F2F5F9" HorizontalAlignment="Left" Margin="34,0,0,0" VerticalAlignment="Center" />
              <Ellipse Width="16" Height="16" Fill="#FF9F1C" HorizontalAlignment="Right" Margin="0,0,30,0" VerticalAlignment="Center" />
              <Ellipse Width="12" Height="12" Fill="#F2F5F9" HorizontalAlignment="Right" Margin="0,0,52,0" VerticalAlignment="Center" />
            </Grid>
          </Viewbox>
          <TextBlock Text="Gaming" FontSize="36" FontWeight="SemiBold"
                     HorizontalAlignment="Center" Margin="0,16,0,0" />
          <TextBlock x:Name="GamingSubtitle" Text="ES-DE" FontSize="19"
                     Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,6,0,0" />
        </StackPanel>
      </Button>

      <Button x:Name="TvTile" Tag="1" Style="{StaticResource TileButtonStyle}"
              Click="Tile_Click" GotFocus="Tile_GotFocus">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <Viewbox Width="150" Height="100">
            <Grid Width="150" Height="100">
              <Border Width="132" Height="76" CornerRadius="8" Background="#1E2534"
                      BorderBrush="#00A6FF" BorderThickness="3" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0" />
              <Rectangle Width="44" Height="5" Fill="#00A6FF" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,6,0,0" />
              <Polygon Points="62,30 62,56 86,43" Fill="#FF9F1C" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0" />
            </Grid>
          </Viewbox>
          <TextBlock Text="TV" FontSize="36" FontWeight="SemiBold"
                     HorizontalAlignment="Center" Margin="0,16,0,0" />
          <TextBlock x:Name="TvSubtitle" Text="HotPlayer" FontSize="19"
                     Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,6,0,0" />
        </StackPanel>
      </Button>

      <Button x:Name="YouTubeTile" Tag="2" Style="{StaticResource TileButtonStyle}"
              Click="Tile_Click" GotFocus="Tile_GotFocus">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <Viewbox Width="150" Height="100">
            <Grid Width="150" Height="100">
              <Border Width="132" Height="84" CornerRadius="18" Background="#E62117"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
              <Polygon Points="62,28 62,62 92,45" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
          </Viewbox>
          <TextBlock Text="YouTube" FontSize="36" FontWeight="SemiBold"
                     HorizontalAlignment="Center" Margin="0,16,0,0" />
          <TextBlock x:Name="YouTubeSubtitle" Text="FreeTube" FontSize="19"
                     Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,6,0,0" />
        </StackPanel>
      </Button>

      <Button x:Name="WindowsTile" Tag="3" Style="{StaticResource TileButtonStyle}"
              Click="Tile_Click" GotFocus="Tile_GotFocus">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <Viewbox Width="110" Height="100">
            <Grid Width="110" Height="100">
              <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
              <Rectangle Grid.Row="0" Grid.Column="0" Fill="#00A6FF" Margin="4" />
              <Rectangle Grid.Row="0" Grid.Column="1" Fill="#00A6FF" Margin="4" />
              <Rectangle Grid.Row="1" Grid.Column="0" Fill="#00A6FF" Margin="4" />
              <Rectangle Grid.Row="1" Grid.Column="1" Fill="#FF9F1C" Margin="4" />
            </Grid>
          </Viewbox>
          <TextBlock Text="Windows" FontSize="36" FontWeight="SemiBold"
                     HorizontalAlignment="Center" Margin="0,16,0,0" />
          <TextBlock x:Name="WindowsSubtitle" Text="Desktop" FontSize="19"
                     Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,6,0,0" />
        </StackPanel>
      </Button>
    </UniformGrid>

    <!-- Footer: status line + input hints. -->
    <Grid Grid.Row="2" Margin="14,12,14,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="StatusText" Grid.Column="0" Text="" FontSize="18"
                 Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"
                 TextWrapping="Wrap" />
      <TextBlock Grid.Column="1" Text="A / Enter  Select    B / Esc  Back    Menu  Settings    Ctrl+Alt+Home  Return home"
                 FontSize="18" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
    </Grid>
  </Grid>
</Window>
